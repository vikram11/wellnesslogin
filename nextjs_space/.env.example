# === DATABASE ===
DATABASE_URL="postgresql://healthlogger:YOUR_PASSWORD@localhost:5432/healthlogger"

# === LLM API (Ollama Cloud — gemma4:31b-cloud with vision support) ===
OLLAMA_API_KEY="your-ollama-api-key"

# === PUSH NOTIFICATIONS ===
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# === EMAIL (Nodemailer SMTP — for self-hosted) ===
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="Health Logger <your-email@gmail.com>"

# === APP URL ===
NEXTAUTH_URL="https://yourdomain.com"
