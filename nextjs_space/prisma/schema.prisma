generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/health_logger/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model BpReading {
  id        String   @id @default(cuid())
  date      DateTime
  systolic  Int
  diastolic Int
  pulse     Int?
  context   String?  // pre-meds, post-meds, etc.
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model Medication {
  id        String   @id @default(cuid())
  name      String
  dosage    String?
  timeSlot  String   // AM, MID, PM
  notes     String?
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model MedicationLog {
  id          String   @id @default(cuid())
  date        DateTime
  timeSlot    String   // AM, MID, PM
  medications String   // JSON array of medication names taken
  compliance  Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
}

model Observation {
  id        String   @id @default(cuid())
  date      DateTime
  category  String   // symptom, appointment, medication_change, activity, protocol, bp_note
  description String
  severity  Int?     // for pain scale 1-10
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([category])
}

model DailyNote {
  id        String   @id @default(cuid())
  date      DateTime
  note      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  label     String?  // optional device label like "Amma's iPhone"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([endpoint])
}

model SavedRecipient {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@index([email])
}

model ReminderSchedule {
  id          String    @id @default(cuid())
  label       String    // e.g. "AM Meds", "PT Exercises", "Take BP Reading"
  time        String    // HH:MM in 24h format, Central time
  enabled     Boolean   @default(true)
  isDefault   Boolean   @default(false) // true for the 3 built-in AM/MID/PM reminders
  lastFiredAt DateTime? // prevents double-firing within same window
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([enabled])
}

model ChatMessage {
  id        String   @id @default(cuid())
  role      String   // user or assistant
  content   String
  imageData String?  // base64 image data (data:image/...) for vision messages
  createdAt DateTime @default(now())

  @@index([createdAt])
}
